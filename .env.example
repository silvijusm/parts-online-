# eBay Browse API (free developer account: https://developer.ebay.com/) — production keyset
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Country the buyer is in; eBay then shows only items that ship there. Empty = no filter.
DELIVERY_COUNTRY=LT
# Brave Search API key for dismantler sites without an API (https://brave.com/search/api/)
BRAVE_API_KEY=
PORT=3000
# eBay Partner Network campaign id; eBay links then carry your affiliate tracking. Empty = no affiliate.
EBAY_CAMPAIGN_ID=
# Limit eBay marketplaces, e.g. EBAY_DE,EBAY_PL. Empty = all (DE, AT, PL, GB, FR, IT, ES, NL, US).
EBAY_MARKETPLACES=
# Show sample results when no API keys are set (for testing only)
DEMO=
# Public site address for canonical links, sitemap.xml and robots.txt
SITE_URL=https://parts-online.onrender.com
# Affiliate query string per domain, appended to outbound links, e.g. {"allegro.pl":"aff_id=123"}
AFFILIATE_PARAMS=
# Paid placements: [{"n":"Name","url":"https://...","info":"...","cc":"LT","until":"2026-12-31"}]
FEATURED_SOURCES=
# Google AdSense publisher id (ca-pub-...) and ad unit slot id; both needed to show ads
ADSENSE_CLIENT=
ADSENSE_SLOT=
# Secret for /api/stats?token=...; empty = stats endpoint disabled
STATS_TOKEN=
